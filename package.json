{
  "name": "ai-service-advisor",
  "private": true,
  "description": "RatchetHub for Independent Auto Repair Shops",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev:web": "pnpm --filter @asa/web dev",
    "dev:api": "pnpm --filter @asa/api dev",
    "build:web": "pnpm --filter @asa/web build",
    "lint:web": "pnpm --filter @asa/web lint",
    "test:api": "pnpm --filter @asa/api test",
    "prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "certs": "sh deploy/scripts/generate-certs.sh"
  }
}
