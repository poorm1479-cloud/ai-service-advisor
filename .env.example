# AI Service Advisor for Independent Auto Repair Shops — local env template
# Copy to .env and adjust.

DATABASE_URL=postgresql+asyncpg://asa:asa@localhost:5432/ai_service_advisor
DATABASE_URL_SYNC=postgresql+psycopg://asa:asa@localhost:5432/ai_service_advisor
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-phase1-dev-secret-min-32-chars!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Dev also allows private/LAN/VPN web origins via regex (e.g. http://192.168.x.x:3000).
# Production: list every real web origin explicitly.
ENVIRONMENT=development
NEXT_PUBLIC_API_URL=http://localhost:8000
# Comma-separated usernames allowed for /admin (dev bootstraps first user)
PLATFORM_ADMIN_USERNAMES=admin
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=admin
# If the browser opens the app by IP/hostname (not localhost), point this at a
# reachable API URL for that client, e.g. http://192.168.0.11:8000, and run
# uvicorn with --host 0.0.0.0.

# Modular AI: heuristic | openai (OpenAI only) | ollama
# openai mode: chat / STT / TTS all via OpenAI (no local fallbacks)
AI_PROVIDER=openai
# Default until overridden in Admin → AI Usage (openai_enabled platform setting)
OPENAI_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STT_MODEL=whisper-1
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OLLAMA_URL=http://localhost:11434
# qwen3:* thinking models work (API sends think:false). llama3.1:latest is lighter/faster.
OLLAMA_MODEL=qwen3:14b
LOCAL_WHISPER_URL=http://localhost:9000/v1
LOCAL_WHISPER_MODEL=whisper-1
PIPER_URL=http://localhost:5000
PIPER_VOICE=en_US-lessac-medium
AUDIO_STORAGE_DIR=storage/audio
MAX_AUDIO_UPLOAD_MB=25

# Phase 5 agents
AGENTS_ENABLED=true
AGENT_LOG_LEVEL=INFO

# Phase 6 — Twilio SMS AI (use TWILIO_PROVIDER=fake for local)
SMS_ENABLED=true
TWILIO_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15550001111
# Auto-buy a Twilio number for each new shop (fake invents +1800… locally)
TWILIO_AUTO_PROVISION_NUMBERS=true
# Never set true in normal ops — deletes IncomingPhoneNumber from the Twilio account.
TWILIO_ALLOW_NUMBER_RELEASE=false
TWILIO_NUMBER_COUNTRY=US
# Optional preferred area code, e.g. 206 (empty = any)
TWILIO_NUMBER_AREA_CODE=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_VALIDATE_SIGNATURE=false
# Origin only (no path). Code appends /v1/webhooks/twilio/{sms,voice}/...
# Wrong: https://abc.ngrok-free.dev/v1/webhooks/twilio/voice  (doubles gather action URL)
TWILIO_WEBHOOK_PUBLIC_URL=
# Voice hang-up: set Twilio number Status Callback URL to
#   {TWILIO_WEBHOOK_PUBLIC_URL}/v1/webhooks/twilio/voice/status  (POST)
# so remote hang-ups clear Live status in Conversations → Calls.
# Required: set Status Callback URL on the Twilio phone number:
#   Status Callback URL  → https://<host>/v1/webhooks/twilio/voice/status
#   Events: completed, busy, no-answer, failed, canceled (POST)
# Media Streams (VOICE_STREAM_ENABLED) also closes Live on hang-up when configured.
# Map inbound To-number → shop UUID: +15550001111:00000000-0000-0000-0000-000000000001
TWILIO_SHOP_MAP=
SMS_QUEUE_BACKEND=memory
SMS_QUEUE_MAX_ATTEMPTS=3
# db = Postgres (survives API restart); memory = process-local only
SMS_STORE_BACKEND=db
IMPORT_STORE_BACKEND=db

# Phase 7 — Twilio Voice AI
VOICE_ENABLED=true
VOICE_PROVIDER=fake
VOICE_QUEUE_BACKEND=memory
VOICE_QUEUE_MAX_ATTEMPTS=3
VOICE_STORE_BACKEND=db
VOICE_TTS_VOICE=Polly.Joanna
VOICE_BARGE_IN=true
VOICE_GATHER_TIMEOUT_SEC=3
# Silent pause after speech before Twilio POSTs (use 1 for ~1s; "auto" is slower)
VOICE_GATHER_SPEECH_TIMEOUT=1
# Empty silence streak: 1 silent re-listen, 2 soft nudge, then hang up at N (default 3)
VOICE_EMPTY_GATHER_HANGUP_AFTER=3
VOICE_STREAM_ENABLED=true
TWILIO_VOICE_SHOP_MAP=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
