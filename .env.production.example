# Production environment template — copy to `.env.production` and fill secrets.
# NEVER commit real `.env.production`.

ENVIRONMENT=production

# --- Database ---
POSTGRES_USER=asa
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=ai_service_advisor

# --- Redis ---
REDIS_PASSWORD=change-me-strong-redis-password

# --- Auth / API ---
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
API_CORS_ORIGINS=https://localhost,https://your-domain.example
UVICORN_WORKERS=2
API_REPLICAS=2
RUN_MIGRATIONS=true
READY_REQUIRE_REDIS=false

# --- Public URLs ---
NEXT_PUBLIC_API_URL=https://localhost/api
HTTP_PORT=80
HTTPS_PORT=443

# --- GHCR images (set to your repo; used by deploy/scripts/rollout.sh pull) ---
# Example: ghcr.io/your-org/ratchethub/api:latest
API_IMAGE=ghcr.io/OWNER/REPO/api:latest
WEB_IMAGE=ghcr.io/OWNER/REPO/web:latest

# --- Observability ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
GRAFANA_ROOT_URL=http://localhost:3001

# --- Backups ---
BACKUP_KEEP_DAYS=14
BACKUP_CRON=0 3 * * *

# --- Optional AI / Twilio (leave empty to use fakes) ---
AI_PROVIDER=ollama
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434
# qwen3:* thinking models work (API sends think:false). llama3.1:latest is lighter/faster.
OLLAMA_MODEL=qwen3:14b

TWILIO_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
