# syntax=docker/dockerfile:1.7
FROM python:3.12-slim-bookworm AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements.txt /app/requirements.txt
RUN pip install -r /app/requirements.txt

COPY apps/api /app
COPY deploy/scripts/entrypoint-api.sh /entrypoint.sh

RUN useradd --create-home --uid 10001 asa \
    && mkdir -p /app/storage/audio /backups \
    && chmod +x /entrypoint.sh \
    && chown -R asa:asa /app /backups /entrypoint.sh

USER asa

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8000/live || exit 1

ENTRYPOINT ["/entrypoint.sh"]
